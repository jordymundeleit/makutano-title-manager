# PostgreSQL AVEC PostGIS (docker compose up -d, Neon, Supabase ou VPS)
DATABASE_URL="postgresql://cadastre:cadastre@localhost:5432/cadastre?schema=public"

# Secret de signature des sessions : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# "true" affiche les connexions rapides et les polygones d'exemple. "false" en production réelle.
NEXT_PUBLIC_DEMO_MODE="true"
